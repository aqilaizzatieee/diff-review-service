# The bearer token clients must send as: Authorization: Bearer <BEARER_TOKEN>
# Generate a random one, e.g.: openssl rand -hex 24
BEARER_TOKEN=change-me-to-a-random-secret

# Port the server listens on
PORT=3000

# Optional: only needed if you want the "llm" provider to actually work.
# If unset, /v1/reviews with options.provider="llm" will always resolve
# to a "failed" job with a clear error (graceful degradation, per spec).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
